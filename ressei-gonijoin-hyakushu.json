    97
   ]
  },
  {
   "id": "ressei-gonijoin-hyakushu-0006",
   "pid": "1088203",
   "pages": [
    164
   ],
   "text": "御製集第三卷わびぬればまたぞ戀しきつれもなき人をねたしと思ひすつれどこひ死なむ命のさきにあふといふなき名をだにもたつと聞かばや待戀いつはりにならむ夕のわが命あすまでありといかがきかれむ遇不逢戀つれなしとこひられし世は昔にてこころよわさの身をぞ恨むる忘戀へだて(イ)はかなくぞ一夜二夜のよかれをも身にならはずと昔うらみし雜名所松いまの世を昔かはらぬ高砂のまつのこころにいかが見るらむ海邊夕タ(イ)見彼せば入、はは彼にいりはてて下かげくるるいろり火のかげ神祇人よりはあはれと思へかすが山しかもたのみをかくる年月釋〓いつかすまむ心の水に風たちてやどりさだめぬ月のすがたは竹おなじくば八百萬代をゆづらなむわが九重の庭のくれたけ山春は花秋はもみぢのからにしき立田の山の名にこそありけれ述懷人としていかでか世にもありふべき五の常のみちはなれては住吉の神もあはれと思はなむこころにかくる和歌のうらなみ夢",
   "poems": [
    "57",
    "58",
    "59",
    "60",
    "61",
    "62",
    "63",
    "64",
    "65",
    "66",
    "67",
    "68",
    "69"
   ],
   "lb": []
  },
  {
   "id": "ressei-gonijoin-hyakushu-0007",
   "pid": "1088203",
   "pages": [
    165
   ],
   "text": "御製集第三卷いかにしていにしへ今の見えつらむ夢のただちはまだ悟り得ず神祇いほすずの川いまもかもきよき流をたのむわれなり釋〓さとるべきその源はひとつにてさまざまにとく道やかはれる神風や",
   "poems": [
    "70",
    "71"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "あらたまの存たつかたの各風にとくるこはりの水のしらなみ",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あすもなほ雪は消えじとあづさ弓おして若菜を今日や摘ままし",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "おもひやるむかしの門の春雨にくる人ぞなきたまのをやなぎ",
   "kana": "",
   "speaker": "",
   "page": 159,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "人すまぬ庭はよもぎに埋もれて軒端にかすむはるの月かげ",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "花ならし雲にはあらぬ白雲のはるはたなびくみよし野の山",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "やよやまて風のまにまにちる櫻ことしあだなるならひ忘れて",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "さくら花ちりてうつろふ庭もせに吹くは色あるはるの夕風",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "年をへて同じ春立つ今日なれどあらたまるとは誰れかいひけむ",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あしびたくけぶりなそへそ難波人わが住む里もたどるかすみに",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "梅の花ゆくへも知らずにほふらしあまつ嵐のかよふかぎりは",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "かつらぎやたかまの空の朝ぼらけ花よりうへはよくものもなし",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "わたの原行方も知らずはてもなし沖つかすみの春のあけぼの",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "白妙に袖ふりはへてこよろぎやめざしもはると磯菜摘むなり",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "梅が香をしるべにはして知りしらず何かあやなく宿はわくべき",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "色まがふ雲なへだてそ花のあたり見つつくらさむ三吉野の山",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "われならぬ人も待ちけり郭公としにまれなる初音とおもへば",
   "kana": "",
   "speaker": "",
   "page": 160,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よしさらばつれなかれとて郭公またぬ寐覺にさすがなくなり",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "飛ぶほたるすくも焚く火に數そひぬあしやの里の夕やみの頃",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "わが宿の花たちばなに降る雨のかをる雫にたちやぬれまし",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "ほととぎす幾聲なきつ大原やをしほの山のむらさめのそら",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "白雲のみちゆきぶりの郭公たがことづてのことかたるらむ",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "五月雨の晴間まち出でて山の端に雲より高くなくほととぎす",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "しろたへのいさごの霜のおきゐつつ月見る程は凉しかりけり",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "にはかにも入日に雲のかかるかないまやとをちの夕立のそら",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "なる神のこゑのとをちになるままにふりすぎてゆく夕立の雨",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "やどごとの夕ぐれとはむ秋といへば我れにかぎらず物や思ふと",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ながめわびぬなきすててゆく初雁の翅にうすき山の端の雲",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "中空にすまぬかぎりは枝しげき谷には月のかげぞもりこぬ",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "けふくれぬやどやからまし草枕たごのいり野は蟲もなくなり",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "秋の嵐さむきあさけの梢には木の葉すくなくなりまさるなり",
   "kana": "",
   "speaker": "",
   "page": 161,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "とふ人を待つとせしまに日數へて下葉もみづる秋はぎの花",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "白露のをかべのすすき初尾花ほのかになびくときはきにけり",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "秋かせの宴きあうけにきにけらし雲にきこゆるはつかりの聲",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "秋風は尾上の松におとづれてゆふべの山をいづるつきかげ",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "いとどなほ月すめとてのあらしかな殘る雲なきあきの大空",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "さらしなや姨捨山もさもあらばあれただ我が宿の雲の上の月",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "誰れならむさきだつ駒のおとはして霧にへだつる瀨田の長橋",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "流れゆく末はそまらず立田川もみぢのかげをあらふしら波",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "しぐるらし紅葉の錦しきしまの山どりのをのなが月のそら",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いかでなほ立田の紅葉しぐるらむこれより深き色はあらじを",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "あかつきの鐘まつ程のときのまを秋と思ふぞかなしかりける",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "今朝よりはまなく時雨のちはやぶる神無月とはむべもいひけり",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夜もすがら閨へもいらぬわが袖になれて有明の月ぞこほれる",
   "kana": "",
   "speaker": "",
   "page": 162,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "吹きよせて木の葉のしたに冬草の殘るを見する山おろしの風",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "あらし吹くならのひろ葉の冬枯にたまらぬ玉は霰なりけり",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "かきくらし降りつる雪のはるる夜に千さとを見せてみがく月影",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "むかしへとなりゆく年の惜しきこそ花もみぢにも猶まさりけれ",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "さゆる日のかさなる雲にこの夕雪ふりきたる山おろしのかぜ",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "たのめずばねなまし月とながめてもうき僞にふくるそらかな",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "わが戀はなほやましなのおとは川あふさか山をこえむかぎりは",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "つれもなき人の心のたねしあれば植ゑぬにおふるこひ忘れ草",
   "kana": "",
   "speaker": "き",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "涙をやあやしと月はやどるらし物おもふころの袖と知らずば",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "時雨には松ももみづる世ともがなつれなき人を今こころみむ",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "あふことをわが心にもまかせねば戀てふものぞくるしかりける",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "よしさらば戀ひ死ぬとだにかこたれず惜まれぬ身はいふかひもなし",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "あらはれむものゆゑやがて忘ればと疑ふかたにしのぶ年月",
   "kana": "",
   "speaker": "",
   "page": 163,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "わびぬればまたぞ戀しきつれもなき人をねたしと思ひすつれど",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "こひ死なむ命のさきにあふといふなき名をだにもたつと聞かばや",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "いつはりにならむ夕のわが命あすまでありといかがきかれむ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "つれなしとこひられし世は昔にてこころよわさの身をぞ恨むる",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "れをも身にならはずと昔うらみし",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "いまの世を昔かはらぬ高砂のまつのこころにいかが見るらむ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "見彼せば入、はは彼にいりはてて下かげくるるいろり火のかげ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "人よりはあはれと思へかすが山しかもたのみをかくる年月",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "いつかすまむ心の水に風たちてやどりさだめぬ月のすがたは",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "おなじくば八百萬代をゆづらなむわが九重の庭のくれたけ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "春は花秋はもみぢのからにしき立田の山の名にこそありけれ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "人としていかでか世にもありふべき五の常のみちはなれては",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "住吉の神もあはれと思はなむこころにかくる和歌のうらなみ",
   "kana": "",
   "speaker": "",
   "page": 164,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "いかにしていにしへ今の見えつらむ夢のただちはまだ悟り得ず",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "さとるべきその源はひとつにてさまざまにとく道やかはれる",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
